{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/.*/**",
      "tests/**",
      "playwright.config.js",
      "test-results.md",
      "serve.json",
      "**/node_modules/**",
      "package.json",
      "package-lock.json",
      "static-server.ps1",
      "FIREBASE-STEPS-NOTES.md",
      "README.md",
      "CLAUDE.md",
      "ACL.md",
      "SCOPE.md",
      "DESIGN.md",
      "docs/**",
      "experiments/**",
      "functions/**",
      "local-ai-proxy/**",
      "seed.html",
      "js/seed.js",
      "js/data.js"
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log"]
    }
  ]
}
