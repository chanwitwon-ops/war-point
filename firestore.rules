// ─────────────────────────────────────────────────────────────
// firestore.rules — กฎขั้นต่ำของการบ้านที่ 2 (เทียบสัปดาห์ที่ 7 leaveeasy): "ต้องล็อกอินก่อน"
//
// ยังไม่แยกสิทธิ์ตาม role (student/teacher) — กฎรายห้องแบบเต็ม
// จะทำในการบ้านที่ 3 (ดู ACL.md)
//
// วิธี publish: คัดลอกไฟล์นี้ทั้งหมด → Firebase Console →
// Firestore Database → แท็บ Rules → วางทับของเดิม → กด Publish
// (หรือรัน `firebase deploy --only firestore:rules` ถ้าติดตั้ง Firebase CLI แล้ว)
// ─────────────────────────────────────────────────────────────

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
