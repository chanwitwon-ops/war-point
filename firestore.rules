// ─────────────────────────────────────────────────────────────
// firestore.rules — การบ้านที่ 3: ปิดช่องข้อมูลรั่วของ quizAttempts
// [แก้เพิ่ม 2026-11-03] ปิดช่องโหว่ที่ BACKLOG.md ระบุไว้ว่า "นักเรียนที่รู้วิธียิง
// request ตรงผ่าน DevTools ยังแก้/ลบชุดข้อสอบหรือข้อมูลนักเรียนคนอื่นได้" — ล็อก
// เขียน students/quizSets ให้เป็น teacher-only แล้ว (ดูหัวข้อ students/quizSets ด้านล่าง)
//
// เดิม (การบ้านที่ 2) เช็คแค่ "ต้องล็อกอินก่อน" (request.auth != null) กับทุก
// เอกสาร — ทำให้นักเรียนคนหนึ่งเปิด/query การส่งงานของนักเรียนอีกคนได้ตรงๆ
// รอบนี้แก้เฉพาะส่วน "เจ้าของข้อมูล" ตาม spec.md หัวข้อ 2-3:
//   - quizAttempts   : อ่านได้เฉพาะเจ้าของ (studentId ตรงกับ uid) หรือ teacher
//                       สร้างใหม่ได้เฉพาะเมื่อ studentId ที่บันทึกตรงกับ uid ผู้เขียน
//                       แก้ไข (ให้คะแนน/เปลี่ยนสถานะ) ได้เฉพาะ teacher เท่านั้น
//   - .../reviews    : เขียนได้เฉพาะ teacher (อ่านได้เฉพาะเจ้าของงานหรือ teacher)
//   - students/quizSets: อ่านได้ทุกคนที่ล็อกอิน (ต้องใช้แสดงชื่อ/ตัวเลือกชุดข้อสอบ)
//                       เขียนจำกัดเฉพาะ teacher แล้ว (เดิม auth != null เปิดให้นักเรียน
//                       เขียนทับได้ด้วย — ตรวจโค้ดจริงแล้วว่าทุกจุดที่เขียน 2 collection
//                       นี้ในแอป (quiz-set-new.js, quiz-attempt-detail.js's AI summary,
//                       seed.js) เป็นการกระทำของ teacher อยู่แล้วทั้งหมด ไม่มีนักเรียนจุดไหน
//                       ที่ต้องเขียน students/quizSets เลย การล็อกจึงไม่กระทบฟีเจอร์ใดๆ)
//
// role ของผู้ใช้อ่านจากเอกสาร users/{uid}.role ("student" | "teacher")
//
// วิธี publish: คัดลอกไฟล์นี้ทั้งหมด → Firebase Console →
// Firestore Database → แท็บ Rules → วางทับของเดิม → กด Publish
// (หรือรัน `firebase deploy --only firestore:rules` ถ้าติดตั้ง Firebase CLI แล้ว)
// ─────────────────────────────────────────────────────────────

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ผู้ใช้ที่ล็อกอินอยู่เป็น teacher หรือไม่ — เช็คจาก users/{uid}.role
    function isTeacher() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "teacher";
    }

    // ── quizAttempts: จุดที่ข้อมูลรั่ว — ต้องเป็นเจ้าของหรือ teacher เท่านั้น ──
    match /quizAttempts/{attemptId} {
      allow read: if request.auth != null &&
        (isTeacher() || resource.data.studentId == request.auth.uid);

      // นักเรียนส่งงานใหม่ได้เฉพาะของตัวเอง (studentId ต้องตรงกับ uid ผู้เขียนเสมอ)
      allow create: if request.auth != null &&
        request.resource.data.studentId == request.auth.uid;

      // เปลี่ยนสถานะ/ให้คะแนน (ตรวจงาน) ทำได้เฉพาะ teacher เท่านั้น
      allow update: if isTeacher();

      // ── reviews: มีเฉพาะงานที่ teacher ตรวจมือ — เขียนได้เฉพาะ teacher ──
      match /reviews/{reviewId} {
        allow read: if request.auth != null &&
          (isTeacher() ||
            get(/databases/$(database)/documents/quizAttempts/$(attemptId)).data.studentId == request.auth.uid);
        allow write: if isTeacher();
      }
    }

    // ── students: อ่านได้ทุกคนที่ล็อกอิน (แสดงชื่อเล่นในรายการ/AI สรุปภาพรวม) ──
    // เขียนได้เฉพาะ teacher เท่านั้น [แก้ 2026-11-03] — กันนักเรียนแก้/ลบข้อมูล
    // นักเรียนคนอื่นผ่าน DevTools/Firestore SDK ตรงๆ (ฟีเจอร์ AI สรุปภาพรวมที่เขียน
    // ลง students.aiSummary เป็นปุ่มของ teacher อยู่แล้ว ไม่กระทบ)
    match /students/{studentId} {
      allow read: if request.auth != null;
      allow write: if isTeacher();

      match /aiLog/{logId} {
        allow read: if request.auth != null;
        allow write: if isTeacher();
      }
    }

    // ── quizSets: อ่านได้ทุกคนที่ล็อกอิน (ต้องใช้เลือกชุดข้อสอบ/แสดงรายการ) ──
    // เขียนได้เฉพาะ teacher เท่านั้น [แก้ 2026-11-03] — กันนักเรียนแก้/ลบชุดข้อสอบ
    // ของครูผ่าน DevTools/Firestore SDK ตรงๆ (สร้าง/แก้ชุดข้อสอบเป็นหน้าของ teacher อยู่แล้ว)
    match /quizSets/{quizSetId} {
      allow read: if request.auth != null;
      allow write: if isTeacher();

      match /aiLog/{logId} {
        allow read: if request.auth != null;
        allow write: if isTeacher();
      }
    }

    // ── users: ผูก role กับ Firebase Auth uid — คงพฤติกรรมเดิม (auth != null) ──
    match /users/{uid} {
      allow read, write: if request.auth != null;
    }

    // ── tournaments: โหมดทัวนาเมนต์แพ้คัดออกสำหรับเดโม 18 ธ.ค. 2026 ──
    // ตาม docs/01-requirements/01-spec/20261103-08-tournament-bracket-demo.md
    // เป็นกิจกรรมสาธารณะของห้อง (ไม่ใช่ข้อมูลส่วนตัวของนักเรียนคนใดคนหนึ่งแบบ
    // quizAttempts) จึงอ่านได้ทุกคนที่ล็อกอิน — แต่เขียน/แก้ bracket หรือผลการ
    // แข่งขันได้เฉพาะ teacher เท่านั้น เพื่อกันไม่ให้ใครโกงผลทัวนาเมนต์วันเดโมจริง
    match /tournaments/{tournamentId} {
      allow read: if request.auth != null;
      allow create, update: if isTeacher();

      // battle log เต็มของแต่ละแมตช์ — อ่านได้ทุกคนที่ล็อกอิน เขียนได้เฉพาะ teacher
      match /matches/{matchId} {
        allow read: if request.auth != null;
        allow write: if isTeacher();
      }
    }

    // ── pets: สัตว์เลี้ยง/แต้มของนักเรียนแต่ละคน (เพิ่ม 2026-11-08) ──
    // ตาม docs/01-requirements/01-spec/20260821-02-pet-points-and-weekly-arena.md
    // แยกออกจาก collection students เดิม (ซึ่งล็อกเป็น teacher-only ไปแล้วด้วยเหตุผล
    // คนละเรื่อง — roster integrity) เพื่อไม่ให้กฎปนกัน — doc id ของ collection นี้คือ
    // Firebase Auth uid ของนักเรียนเจ้าของโดยตรง (ไม่ใช่ id ปลอมแบบ students/{id} เดิม)
    // เจ้าของแก้ pet/growthHistory ของตัวเองได้เท่านั้น (ไม่มีใครแก้ของคนอื่นได้แม้แต่ teacher
    // เพราะเป็นแต้ม/สัตว์เลี้ยงที่ผูกกับความพยายามเรียนของนักเรียนคนนั้นโดยตรง)
    // **หมายเหตุด้านความปลอดภัย:** กฎนี้ตรวจแค่ชนิด/ขอบเขตของข้อมูล (stage ต้องเป็นเลข
    // 0-4) ไม่ได้ตรวจย้อนกลับว่าแต้มที่ใช้จริงพอหรือไม่ (ต้องรวมผลรวม quizAttempts ซึ่ง
    // Firestore rules ทำ aggregate query แบบนั้นไม่ได้) เป็นโมเดลความน่าเชื่อถือเดียวกับ
    // quizAttempts.scoreAwarded ที่มีอยู่แล้วในระบบ (เชื่อฝั่ง client เป็นหลัก ไม่ใช่ anti-cheat
    // เต็มรูปแบบ) เหมาะกับสเกลการบ้าน/เดโมในห้องเรียน ไม่ใช่ระบบแข่งขันที่มีเดิมพันสูง
    match /pets/{uid} {
      allow read: if request.auth != null;
      // [แก้ 2026-11-08] ต้องยอมรับกรณี pet == null ด้วย (ตอนรีเซ็ตสัตว์เลี้ยง) — เดิมเช็ค
      // .stage ตรงๆ ทุกครั้งทำให้ CEL evaluation error เมื่อ pet เป็น null แล้วถูก deny
      // ทั้งก้อนจริงในโปรดักชัน (พบระหว่างทดสอบ data layer ด้วย mock — mock เองไม่บังคับใช้
      // security rules จึงไม่เจอตอนรันเทสต์ ต้องแก้ตรงนี้แทน)
      allow create, update: if request.auth != null && request.auth.uid == uid &&
        (request.resource.data.pet == null ||
         (request.resource.data.pet.stage is int &&
          request.resource.data.pet.stage >= 0 && request.resource.data.pet.stage <= 4));
      allow delete: if false; // ไม่มีการลบสัตว์เลี้ยงทิ้ง — รีเซ็ตคือเขียน pet ใหม่ทับ ไม่ใช่ลบเอกสาร
    }
  }
}
