// ─────────────────────────────────────────────────────────────
// firestore.rules — การบ้านที่ 3: ปิดช่องข้อมูลรั่วของ quizAttempts
// [แก้เพิ่ม 2026-11-03] ปิดช่องโหว่ที่ BACKLOG.md ระบุไว้ว่า "นักเรียนที่รู้วิธียิง
// request ตรงผ่าน DevTools ยังแก้/ลบชุดข้อสอบหรือข้อมูลนักเรียนคนอื่นได้" — ล็อก
// เขียน students/quizSets ให้เป็น teacher-only แล้ว (ดูหัวข้อ students/quizSets ด้านล่าง)
//
// เดิม (การบ้านที่ 2) เช็คแค่ "ต้องล็อกอินก่อน" (request.auth != null) กับทุก
// เอกสาร — ทำให้นักเรียนคนหนึ่งเปิด/query การส่งงานของนักเรียนอีกคนได้ตรงๆ
// รอบนี้แก้เฉพาะส่วน "เจ้าของข้อมูล" ตาม spec.md หัวข้อ 2-3:
//   - quizAttempts   : อ่านได้เฉพาะเจ้าของ (studentId ตรงกับ uid) หรือ teacher
//                       สร้างใหม่ได้เฉพาะเมื่อ studentId ที่บันทึกตรงกับ uid ผู้เขียน
//                       แก้ไข (ให้คะแนน/เปลี่ยนสถานะ) ได้เฉพาะ teacher เท่านั้น
//   - .../reviews    : เขียนได้เฉพาะ teacher (อ่านได้เฉพาะเจ้าของงานหรือ teacher)
//   - students/quizSets: อ่านได้ทุกคนที่ล็อกอิน (ต้องใช้แสดงชื่อ/ตัวเลือกชุดข้อสอบ)
//                       เขียนจำกัดเฉพาะ teacher แล้ว (เดิม auth != null เปิดให้นักเรียน
//                       เขียนทับได้ด้วย — ตรวจโค้ดจริงแล้วว่าทุกจุดที่เขียน 2 collection
//                       นี้ในแอป (quiz-set-new.js, quiz-attempt-detail.js's AI summary,
//                       seed.js) เป็นการกระทำของ teacher อยู่แล้วทั้งหมด ไม่มีนักเรียนจุดไหน
//                       ที่ต้องเขียน students/quizSets เลย การล็อกจึงไม่กระทบฟีเจอร์ใดๆ)
//
// role ของผู้ใช้อ่านจากเอกสาร users/{uid}.role ("student" | "teacher")
//
// วิธี publish: คัดลอกไฟล์นี้ทั้งหมด → Firebase Console →
// Firestore Database → แท็บ Rules → วางทับของเดิม → กด Publish
// (หรือรัน `firebase deploy --only firestore:rules` ถ้าติดตั้ง Firebase CLI แล้ว)
// ─────────────────────────────────────────────────────────────

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ผู้ใช้ที่ล็อกอินอยู่เป็น teacher หรือไม่ — เช็คจาก users/{uid}.role
    function isTeacher() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "teacher";
    }

    // ครั้งที่ส่ง (attemptNo) ต้องอยู่ใน 1..maxAttempts ของชุด — ชุดที่ไม่มี maxAttempts ใช้ 3
    // (ต้องตรงกับ จำนวนครั้งเริ่มต้น ใน js/util.js)
    function attemptCreateValid(a, qs) {
      return a.attemptNo is int && a.attemptNo >= 1 && a.attemptNo <= qs.get("maxAttempts", 3) &&
        attemptScoreValid(a, qs);
    }

    function attemptScoreValid(a, qs) {
      return (qs.format == "mcq" && a.status == "graded" &&
              a.scoreAwarded is int && a.scoreAwarded >= 0 && a.scoreAwarded <= qs.fullScore) ||
             (qs.format != "mcq" && a.status == "pending_review" && a.scoreAwarded == null);
    }

    // ── quizAttempts: จุดที่ข้อมูลรั่ว — ต้องเป็นเจ้าของหรือ teacher เท่านั้น ──
    match /quizAttempts/{attemptId} {
      allow read: if request.auth != null &&
        (isTeacher() || resource.data.studentId == request.auth.uid);

      // นักเรียนส่งงานใหม่ได้เฉพาะของตัวเอง (studentId ต้องตรงกับ uid ผู้เขียนเสมอ)
      // [แก้ 2026-11-09] ปิดช่องปลอมแต้ม — เดิมสร้าง status "graded" พร้อม scoreAwarded เท่าไหร่ก็ได้
      // และส่งซ้ำได้ไม่จำกัด (แต้มสัตว์เลี้ยง/กระดานเกียรติยศเชื่อตัวเลขนี้):
      //   - id ต้องเป็น {quizSetId}_{uid}_{attemptNo} และ attemptNo อยู่ใน 1..maxAttempts ที่ครูตั้ง
      //     → ทำได้ไม่เกินจำนวนครั้งที่ครูตั้ง (ส่งครั้งเดิมซ้ำ = update ซึ่งเป็นสิทธิ์ครูเท่านั้น)
      //     แต้มนับคะแนนรอบดีที่สุดของแต่ละชุด (js/util.js แต้มจากคะแนนดีที่สุดต่อชุด)
      //   - ชุดข้อสอบต้องมีจริง
      //   - mcq: graded ได้ แต่คะแนนเป็นจำนวนเต็ม 0..fullScore ของชุดนั้น
      //   - ชุดตรวจมือ: ต้องเป็น pending_review และ scoreAwarded = null (ครูให้คะแนนทีหลัง)
      // ข้อจำกัดที่เหลือ: rules ตรวจคำตอบทีละข้อไม่ได้ นักเรียนที่ใช้ DevTools ยังให้ตัวเองได้
      // คะแนนเต็มของชุด mcq ได้ (ชุดละครั้ง) — ปิดสนิทต้องตรวจฝั่งเซิร์ฟเวอร์ (Cloud Functions/Blaze)
      allow create: if request.auth != null &&
        request.resource.data.studentId == request.auth.uid &&
        request.resource.data.attemptNo is int &&
        attemptId == request.resource.data.quizSetId + "_" + request.auth.uid + "_" +
          string(request.resource.data.attemptNo) &&
        request.resource.data.keys().hasOnly(["studentId", "studentNickname", "quizSetId",
          "quizSetTitle", "attemptNo", "submittedAt", "status", "scoreAwarded", "submittedText"]) &&
        exists(/databases/$(database)/documents/quizSets/$(request.resource.data.quizSetId)) &&
        attemptCreateValid(request.resource.data,
          get(/databases/$(database)/documents/quizSets/$(request.resource.data.quizSetId)).data);

      // เปลี่ยนสถานะ/ให้คะแนน (ตรวจงาน) ทำได้เฉพาะ teacher เท่านั้น
      allow update: if isTeacher();

      // ── reviews: มีเฉพาะงานที่ teacher ตรวจมือ — เขียนได้เฉพาะ teacher ──
      match /reviews/{reviewId} {
        allow read: if request.auth != null &&
          (isTeacher() ||
            get(/databases/$(database)/documents/quizAttempts/$(attemptId)).data.studentId == request.auth.uid);
        allow write: if isTeacher();
      }
    }

    // ── students: อ่านได้ทุกคนที่ล็อกอิน (แสดงชื่อเล่นในรายการ/AI สรุปภาพรวม) ──
    // เขียนได้เฉพาะ teacher เท่านั้น [แก้ 2026-11-03] — กันนักเรียนแก้/ลบข้อมูล
    // นักเรียนคนอื่นผ่าน DevTools/Firestore SDK ตรงๆ (ฟีเจอร์ AI สรุปภาพรวมที่เขียน
    // ลง students.aiSummary เป็นปุ่มของ teacher อยู่แล้ว ไม่กระทบ)
    match /students/{studentId} {
      allow read: if request.auth != null;
      allow write: if isTeacher();

      match /aiLog/{logId} {
        allow read: if request.auth != null;
        allow write: if isTeacher();
      }
    }

    // ── quizSets: อ่านได้ทุกคนที่ล็อกอิน (ต้องใช้เลือกชุดข้อสอบ/แสดงรายการ) ──
    // เขียนได้เฉพาะ teacher เท่านั้น [แก้ 2026-11-03] — กันนักเรียนแก้/ลบชุดข้อสอบ
    // ของครูผ่าน DevTools/Firestore SDK ตรงๆ (สร้าง/แก้ชุดข้อสอบเป็นหน้าของ teacher อยู่แล้ว)
    match /quizSets/{quizSetId} {
      allow read: if request.auth != null;
      allow write: if isTeacher();

      match /aiLog/{logId} {
        allow read: if request.auth != null;
        allow write: if isTeacher();
      }
    }

    // ── users: ผูก role กับ Firebase Auth uid ──
    // [แก้ 2026-11-09] เดิม write: auth != null ทำให้นักเรียนตั้ง role เป็น teacher เอง
    // หรือเขียนทับ/ลบเอกสารของคนอื่นได้ผ่าน DevTools
    // - read  : คงเดิม (หน้าทัวนาเมนต์/กระดานเกียรติยศ query รายชื่อ role == "student")
    // - create: เฉพาะเอกสารของตัวเอง และ role ต้องเป็น "student" (ตรงกับ js/register.js)
    // - update: เฉพาะของตัวเอง ห้ามเปลี่ยน role (ตอนนี้ไม่มีโค้ดในแอปจุดไหน update)
    // - delete: ไม่อนุญาต
    // ตั้ง teacher ทำผ่าน Firebase Console เท่านั้น (Console ไม่ผ่าน rules)
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.role == "student" &&
        request.resource.data.keys().hasOnly(["name", "email", "role"]);
      allow update: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.keys().hasOnly(["name", "email", "role"]);
      allow delete: if false;
    }

    // ── tournaments: โหมดทัวนาเมนต์แพ้คัดออกสำหรับเดโม 18 ธ.ค. 2026 ──
    // ตาม docs/01-requirements/01-spec/20261103-08-tournament-bracket-demo.md
    // เป็นกิจกรรมสาธารณะของห้อง (ไม่ใช่ข้อมูลส่วนตัวของนักเรียนคนใดคนหนึ่งแบบ
    // quizAttempts) จึงอ่านได้ทุกคนที่ล็อกอิน — แต่เขียน/แก้ bracket หรือผลการ
    // แข่งขันได้เฉพาะ teacher เท่านั้น เพื่อกันไม่ให้ใครโกงผลทัวนาเมนต์วันเดโมจริง
    match /tournaments/{tournamentId} {
      allow read: if request.auth != null;
      allow create, update: if isTeacher();
      // [เพิ่ม 2026-11-09] ครูลบทัวนาเมนต์ได้ (เช่นจำลองการต่อสู้ทุกวัน/ลบรอบซ้อม) — battle log
      // ใน matches/ ลบได้ด้วย allow write ด้านล่างอยู่แล้ว
      allow delete: if isTeacher();

      // battle log เต็มของแต่ละแมตช์ — อ่านได้ทุกคนที่ล็อกอิน เขียนได้เฉพาะ teacher
      match /matches/{matchId} {
        allow read: if request.auth != null;
        allow write: if isTeacher();
      }
    }

    // ── leaderboard: ผลสรุปกระดานคะแนน (เพิ่ม 2026-11-08) ──
    // ตาม docs/01-requirements/01-spec/20261108-09-leaderboard.md (Gap G-LB-01)
    // นักเรียนอ่าน quizAttempts ของคนอื่นไม่ได้ จึงให้ครูคำนวณแล้วบันทึกผลสรุปไว้ที่นี่ —
    // เก็บเฉพาะคนครึ่งบนที่ขึ้นโชว์ (คนครึ่งล่างไม่มีข้อมูลในเอกสารนี้เลย) พร้อม attemptIds ให้ตรวจย้อนได้
    // อ่านได้ทุกคนที่ล็อกอิน (ต้องล็อกอินก่อนถึงจะเห็น) · เขียนได้เฉพาะครู — นักเรียนแก้คะแนนตัวเองไม่ได้
    match /leaderboard/{docId} {
      allow read: if request.auth != null;
      allow write: if isTeacher();
    }

    // ── pets: สัตว์เลี้ยง/แต้มของนักเรียนแต่ละคน (เพิ่ม 2026-11-08) ──
    // ตาม docs/01-requirements/01-spec/20260821-02-pet-points-and-weekly-arena.md
    // แยกออกจาก collection students เดิม (ซึ่งล็อกเป็น teacher-only ไปแล้วด้วยเหตุผล
    // คนละเรื่อง — roster integrity) เพื่อไม่ให้กฎปนกัน — doc id ของ collection นี้คือ
    // Firebase Auth uid ของนักเรียนเจ้าของโดยตรง (ไม่ใช่ id ปลอมแบบ students/{id} เดิม)
    // เจ้าของแก้ pet/growthHistory ของตัวเองได้เท่านั้น (ไม่มีใครแก้ของคนอื่นได้แม้แต่ teacher
    // เพราะเป็นแต้ม/สัตว์เลี้ยงที่ผูกกับความพยายามเรียนของนักเรียนคนนั้นโดยตรง)
    // **หมายเหตุด้านความปลอดภัย:** กฎนี้ตรวจแค่ชนิด/ขอบเขตของข้อมูล (stage ต้องเป็นเลข
    // 0-4) ไม่ได้ตรวจย้อนกลับว่าแต้มที่ใช้จริงพอหรือไม่ (ต้องรวมผลรวม quizAttempts ซึ่ง
    // Firestore rules ทำ aggregate query แบบนั้นไม่ได้) เป็นโมเดลความน่าเชื่อถือเดียวกับ
    // quizAttempts.scoreAwarded ที่มีอยู่แล้วในระบบ (เชื่อฝั่ง client เป็นหลัก ไม่ใช่ anti-cheat
    // เต็มรูปแบบ) เหมาะกับสเกลการบ้าน/เดโมในห้องเรียน ไม่ใช่ระบบแข่งขันที่มีเดิมพันสูง
    match /pets/{uid} {
      // [เพิ่ม 2026-11-08 สเปก 02 ซ.14] สเตตัสต้องตรงกติกาการสุ่ม: ครบ 6 ค่า จำนวนเต็ม ทุกค่าอยู่ในช่วง
      // (ค่าต่อขั้น × จำนวนขั้น) — นักเรียนตั้งสเตตัสเกินกติกาผ่าน DevTools ไม่ได้
      // ช่วงต่อขั้นต้องตรงกับ PET_STAT_RANGE_PER_STAGE ใน js/pet-config.js
      // (SPD 9–15, ATK 5–9, ACC 6–10, EVA 9–15, DEF 3–5, HP 5–9)
      // [แก้ 2026-11-09] เลิกตรวจ "ผลรวม = 50 × ขั้น" → ตรวจ "งบ" แทน (ATK/HP แต้มละ 2.25 ค่าอื่น 1
      // งบ 67.5 ± 1 ต่อขั้น) คิดเป็นจำนวนเต็ม ×4: 4×(SPD+ACC+EVA+DEF) + 9×(ATK+HP) อยู่ใน 266n–274n
      function statsValid(st, n) {
        return st.keys().hasOnly(["SPD", "ATK", "ACC", "EVA", "DEF", "HP"]) &&
          st.SPD is int && st.ATK is int && st.ACC is int && st.EVA is int && st.DEF is int && st.HP is int &&
          st.SPD >= 9 * n && st.SPD <= 15 * n &&
          st.ATK >= 5 * n && st.ATK <= 9 * n &&
          st.ACC >= 6 * n && st.ACC <= 10 * n &&
          st.EVA >= 9 * n && st.EVA <= 15 * n &&
          st.DEF >= 3 * n && st.DEF <= 5 * n &&
          st.HP >= 5 * n && st.HP <= 9 * n &&
          4 * (st.SPD + st.ACC + st.EVA + st.DEF) + 9 * (st.ATK + st.HP) >= 266 * n &&
          4 * (st.SPD + st.ACC + st.EVA + st.DEF) + 9 * (st.ATK + st.HP) <= 274 * n;
      }

      allow read: if request.auth != null;
      // [แก้ 2026-11-08] ต้องยอมรับกรณี pet == null ด้วย (ตอนรีเซ็ตสัตว์เลี้ยง) — เดิมเช็ค
      // .stage ตรงๆ ทุกครั้งทำให้ CEL evaluation error เมื่อ pet เป็น null แล้วถูก deny
      // ทั้งก้อนจริงในโปรดักชัน (พบระหว่างทดสอบ data layer ด้วย mock — mock เองไม่บังคับใช้
      // security rules จึงไม่เจอตอนรันเทสต์ ต้องแก้ตรงนี้แทน)
      allow create, update: if request.auth != null && request.auth.uid == uid &&
        (request.resource.data.pet == null ||
         (request.resource.data.pet.stage is int &&
          request.resource.data.pet.stage >= 0 && request.resource.data.pet.stage <= 4 &&
          // [แก้ 2026-11-09] แต้มที่ใช้ต้องตรงราคาสะสมของขั้น (PET_STAGE_CUMULATIVE_COST ใน
          // js/pet-config.js: 1, 6, 16, 31, 51) — เดิมเขียน stage 4 + pointsSpent 0 ได้ฟรี
          request.resource.data.pet.pointsSpent == [1, 6, 16, 31, 51][request.resource.data.pet.stage] &&
          statsValid(request.resource.data.pet.stats, request.resource.data.pet.stage + 1)));
      allow delete: if false; // ไม่มีการลบสัตว์เลี้ยงทิ้ง — รีเซ็ตคือเขียน pet ใหม่ทับ ไม่ใช่ลบเอกสาร
    }
  }
}
